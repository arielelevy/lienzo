# dependencias y builds
web/node_modules/
web/dist/
*.tsbuildinfo

# python
__pycache__/
*.pyc

# datos reales de sesiones (payloads de hooks con rutas y prompts)
ejemplos/

# locales
*.log
.env
Thumbs.db

# documento interno de diseno (queda fuera del repo publico)
DISENO.es.md

# videos de la UI (pesados)
docs/video/

# artefactos de las pruebas de interfaz (la config los manda a node_modules, pero un --reporter
# distinto o un playwright suelto los deja aca)
web/test-results/
web/playwright-report/
web/.startup-build-pending
node_modules/

# evidencia regenerada por pruebas-agenticas (las propuestas requieren revisión)
pruebas-agenticas/resultados/

# carpeta de trabajo de coda (planes, olas, docs de workflows): no es del repo
.coda/

# plugins locales (lienzo/plugins.py, web/src/plugins.tsx): viven solo en la PC que los usa
lienzo/extensiones/
web/src/extensiones/
tests/extensiones/
pruebas-agenticas/extensiones/
